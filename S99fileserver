#!/bin/sh
# RK3568 文件服务器自启脚本
DAEMON=/userdata/app/file_server.py
PIDFILE=/var/run/fileserver.pid
LOGFILE=/userdata/app/fileserver.log

start() {
    echo "Starting file server..."
    if [ -f "$PIDFILE" ] && kill -0 $(cat $PIDFILE) 2>/dev/null; then
        echo "Already running (pid $(cat $PIDFILE))"
        return
    fi
    rotate_log
    nohup /usr/bin/python3 -u $DAEMON >> $LOGFILE 2>&1 &
    echo $! > $PIDFILE
    sleep 1
    if kill -0 $(cat $PIDFILE) 2>/dev/null; then
        echo "Started (pid $(cat $PIDFILE))"
    else
        echo "Failed to start, check $LOGFILE"
    fi
}

# 日志轮转：超过 1MB 时存档旧日志，最多保留 3 份历史（.1 ~ .3）
rotate_log() {
    if [ -f "$LOGFILE" ] && [ $(wc -c < "$LOGFILE") -gt 1048576 ]; then
        rm -f "$LOGFILE.3"
        [ -f "$LOGFILE.2" ] && mv "$LOGFILE.2" "$LOGFILE.3"
        [ -f "$LOGFILE.1" ] && mv "$LOGFILE.1" "$LOGFILE.2"
        mv "$LOGFILE" "$LOGFILE.1"
        echo "Log rotated (>1MB), old log kept as $(basename $LOGFILE).1"
    fi
}

stop() {
    echo "Stopping file server..."
    if [ -f "$PIDFILE" ]; then
        kill $(cat $PIDFILE) 2>/dev/null
        rm -f $PIDFILE
        echo "Stopped"
    else
        echo "Not running"
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
